# Copy to .env.local for local development. Per-environment values live in
# Vercel (site) and Railway (API); no secrets in the repo.

# Canonical, OG and sitemap URLs point at the final domain from day one
# (brief §2a) so nothing is rewritten at go-live. Override only for a
# branded staging link.
NEXT_PUBLIC_SITE_URL=https://motorclaimsdepartment.co.uk

# Set automatically by Vercel: production | preview | development.
# Anything other than "production" gets X-Robots-Tag and <meta robots> noindex.
# Leave unset locally to see staging behaviour; set to production to see the
# production head.
# VERCEL_ENV=

# Footer legal line (brief §11). Exactly as on the FCA Register. On preview a
# visible [TODO] renders while unset; the production build stops until it is set.
# FCA_STATUS_LINE="Motor Claims Department Ltd is authorised and regulated by the Financial Conduct Authority, firm reference number 000000."

{
  "name": "mcd-claims-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Claims API for motorclaimsdepartment.co.uk: submissions, reg lookup proxy, CRM hand-off. Runs on Railway.",
  "engines": { "node": ">=22" },
  "scripts": {

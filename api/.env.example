# Railway sets DATABASE_URL and PORT. Set the rest per environment; staging and
# production are separate services with separate databases and inboxes.
DATABASE_URL=
# One bearer key per front end, as label:secret pairs; the label is recorded on
# each submission. CLAIMS_API_KEY alone still works (labelled "default").
CLAIMS_API_KEYS=mcd1:,mcd2:
CLAIMS_API_KEY=
CLAIMS_INBOX=claims-staging@example.invalid
# DVLA Vehicle Enquiry API, off at launch (brief §7). Never exposed to the browser.
DVLA_API_KEY=
